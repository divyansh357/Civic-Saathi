# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (Docker):
DB_URL=jdbc:postgresql://localhost:5432/Civic
# Supabase (production) — get from: Project Settings → Database → JDBC connection string
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?user=postgres.xxxx&password=YOUR_PASSWORD

DB_USERNAME=postgres
DB_PASSWORD=root
JPA_DDL_AUTO=none

# ── Postgres container (Docker Compose only) ───────────────────────────────────
POSTGRES_DB=Civic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# ── JWT ────────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Render can auto-generate this.
JWT_SECRET=change-this-secret-for-production-min-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ── Server ─────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Web dashboard (Vite) ───────────────────────────────────────────────────────
# Local:
VITE_API_URL=http://localhost:8080/api/v1
# Production (set in Vercel dashboard as VITE_API_URL):
# VITE_API_URL=https://civic-saathi-backend.onrender.com/api/v1
VITE_API_TIMEOUT=30000

# ── Mobile app (Expo) ──────────────────────────────────────────────────────────
# Set in mobile-app/.env
# EXPO_PUBLIC_API_URL=https://civic-saathi-backend.onrender.com/api/v1

# ── AI / LLM (optional) ────────────────────────────────────────────────────────
# Get your key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_MAX_TOKENS=512

# ── Logging (production — keep WARN to reduce noise) ──────────────────────────
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SQL_BINDER=WARN
